# Configuración del servidor FastAPI
PORT=8000
HOST=0.0.0.0

# API Keys para Modelos de IA
# Cohere API Key: Obtener en https://dashboard.cohere.com/api-keys (Para Embeddings y Búsqueda Semántica RAG)
COHERE_API_KEY=tu_cohere_api_key_aqui

# Groq API Key: Obtener en https://console.groq.com/keys (Para LLM de Inferencia Ultra Rápida)
GROQ_API_KEY=tu_groq_api_key_aqui

# Tavily API Key: Obtener en https://tavily.com (Para Búsqueda Web de IA con LangChain)
TAVILY_API_KEY=tu_tavily_api_key_aqui

# Configuración de Modelos RAG
COHERE_EMBEDDING_MODEL=embed-multilingual-v3.0
GROQ_MODEL=llama-3.3-70b-versatile
DATA_DIR=./data
